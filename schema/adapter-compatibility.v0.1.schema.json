{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/adapter-compatibility.v0.1.schema.json",
  "title": "CARTOGRAPH adapter compatibility registry v0.1",
  "description": "Versioned adapter/core negotiation dimensions and bounded migration windows evaluated before adapter analysis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "mediaType",
    "current",
    "migrations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.adapter-compatibility" },
    "mediaType": {
      "const": "application/vnd.cartograph.adapter-compatibility+json"
    },
    "current": { "$ref": "#/definitions/tuple" },
    "migrations": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/definitions/migration" }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "compatibilityVersion",
        "capabilityRegistryVersion",
        "graphSchemaVersion"
      ],
      "properties": {
        "apiVersion": { "type": "integer", "minimum": 0 },
        "compatibilityVersion": { "type": "integer", "minimum": 0 },
        "capabilityRegistryVersion": {
          "type": "integer",
          "minimum": 0
        },
        "graphSchemaVersion": { "type": "integer", "minimum": 0 }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "status", "expiresOn", "guidance"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "from": { "$ref": "#/definitions/tuple" },
        "to": { "$ref": "#/definitions/tuple" },
        "status": { "enum": ["active", "deprecated"] },
        "expiresOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "guidance": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    }
  }
}
