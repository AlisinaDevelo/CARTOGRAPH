{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/diff-benchmark-result.v0.1.schema.json",
  "title": "CARTOGRAPH bounded diff benchmark result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactVersion",
    "protocolVersion",
    "generatedAt",
    "tool",
    "manifest",
    "runs",
    "workloads"
  ],
  "properties": {
    "artifactVersion": { "const": 1 },
    "protocolVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "tool": { "$ref": "#/definitions/tool" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "workloads"],
      "properties": {
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "workloads": { "type": "integer", "minimum": 1 }
      }
    },
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cold", "warm"],
      "properties": {
        "cold": { "type": "integer", "minimum": 1 },
        "warm": { "type": "integer", "minimum": 1 }
      }
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/workload" }
    }
  },
  "definitions": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageVersion",
        "nodeVersion",
        "platform",
        "arch",
        "cpuCount",
        "totalMemoryBytes"
      ],
      "properties": {
        "packageVersion": { "type": "string", "minLength": 1 },
        "nodeVersion": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "cpuCount": { "type": "integer", "minimum": 1 },
        "totalMemoryBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runs",
        "minMs",
        "medianMs",
        "p95Ms",
        "maxMs",
        "peakRssBytes"
      ],
      "properties": {
        "runs": { "type": "integer", "minimum": 1 },
        "minMs": { "type": "number", "minimum": 0 },
        "medianMs": { "type": "number", "minimum": 0 },
        "p95Ms": { "type": "number", "minimum": 0 },
        "maxMs": { "type": "number", "minimum": 0 },
        "peakRssBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "cardinality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "edgeDensity"],
      "properties": {
        "nodes": { "type": "integer", "minimum": 1 },
        "edges": { "type": "integer", "minimum": 0 },
        "edgeDensity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matches", "ambiguous", "unsupported", "ambiguityPercent"],
      "properties": {
        "matches": { "type": "integer", "minimum": 0 },
        "ambiguous": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "ambiguityPercent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodesAdded",
        "nodesRemoved",
        "nodesChanged",
        "edgesAdded",
        "edgesRemoved",
        "edgesChanged",
        "diagnosticsAdded",
        "diagnosticsRemoved",
        "diagnosticsChanged"
      ],
      "properties": {
        "nodesAdded": { "type": "integer", "minimum": 0 },
        "nodesRemoved": { "type": "integer", "minimum": 0 },
        "nodesChanged": { "type": "integer", "minimum": 0 },
        "edgesAdded": { "type": "integer", "minimum": 0 },
        "edgesRemoved": { "type": "integer", "minimum": 0 },
        "edgesChanged": { "type": "integer", "minimum": 0 },
        "diagnosticsAdded": { "type": "integer", "minimum": 0 },
        "diagnosticsRemoved": { "type": "integer", "minimum": 0 },
        "diagnosticsChanged": { "type": "integer", "minimum": 0 }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tier",
        "inputDigest",
        "before",
        "after",
        "identity",
        "diff",
        "reportBytes",
        "cold",
        "warm"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["small", "medium", "large"] },
        "inputDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "before": { "$ref": "#/definitions/cardinality" },
        "after": { "$ref": "#/definitions/cardinality" },
        "identity": { "$ref": "#/definitions/identity" },
        "diff": { "$ref": "#/definitions/summary" },
        "reportBytes": { "type": "integer", "minimum": 0 },
        "cold": { "$ref": "#/definitions/timing" },
        "warm": { "$ref": "#/definitions/timing" }
      }
    }
  }
}
