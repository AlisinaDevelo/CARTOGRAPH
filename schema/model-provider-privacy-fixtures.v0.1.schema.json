{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/model-provider-privacy-fixtures.v0.1.schema.json",
  "title": "CARTOGRAPH model-provider privacy fixtures v0.1",
  "description": "Offline policy scenarios for the design-only model-provider privacy boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.model-provider-privacy-fixtures" },
    "cases": {
      "type": "array",
      "minItems": 11,
      "maxItems": 16,
      "items": { "$ref": "#/definitions/case" }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "threat",
        "inputClass",
        "expectedDisposition",
        "redaction",
        "noRawLeak",
        "networkAllowed",
        "syntheticMarker",
        "expectedReason"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "threat": {
          "enum": [
            "no-provider-default",
            "source-prompt-injection",
            "issue-prompt-injection",
            "secret-exfiltration",
            "untrusted-report",
            "malicious-suggestion",
            "provider-failure",
            "nondeterminism",
            "misleading-confidence",
            "redaction",
            "training-policy-unknown",
            "budget-exceeded"
          ]
        },
        "inputClass": {
          "enum": [
            "configuration",
            "source",
            "issue",
            "suggestion",
            "report",
            "provider-response",
            "provider-transport"
          ]
        },
        "expectedDisposition": {
          "enum": ["local-only", "redact-and-send", "deferred"]
        },
        "redaction": { "enum": ["not-needed", "applied", "field-omitted"] },
        "noRawLeak": { "const": true },
        "networkAllowed": { "type": "boolean" },
        "syntheticMarker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "expectedReason": { "type": "string", "minLength": 1, "maxLength": 320 }
      }
    }
  }
}
