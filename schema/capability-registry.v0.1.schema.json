{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/capability-registry.v0.1.schema.json",
  "title": "CARTOGRAPH capability and unknown-semantics registry v0.1",
  "description": "Versioned extractor capabilities, diagnostic codes, confidence levels, and examples.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "extractors"],
  "properties": {
    "registryVersion": { "const": 1 },
    "extractors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/extractor" }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "diagnosticCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "confidence": {
      "enum": ["certain", "inferred", "observed", "user_confirmed"]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "diagnosticCodes", "confidence", "examples"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "diagnosticCodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/diagnosticCode" }
        },
        "confidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/confidence" }
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "capabilities"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "version": { "type": "string", "pattern": "^\\d+(?:\\.\\d+)*$" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/capability" }
        }
      }
    }
  }
}
