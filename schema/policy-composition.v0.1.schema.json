{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/policy-composition.v0.1.schema.json",
  "title": "CARTOGRAPH composed local policy v0.1",
  "description": "Deterministic offline composition metadata for repository-local policy files, including precedence, authorized overrides, and conflict-free rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "rootPath",
    "policy",
    "sources",
    "overrides"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.policy-composition" },
    "rootPath": { "$ref": "#/definitions/policyPath" },
    "policy": {
      "$ref": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/policy.v0.1.schema.json"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/definitions/source" }
    },
    "overrides": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/definitions/override" }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "policyPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!~)(?!//)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "policyId",
        "version",
        "scope",
        "precedence",
        "ruleCount"
      ],
      "properties": {
        "path": { "$ref": "#/definitions/policyPath" },
        "policyId": { "$ref": "#/definitions/identifier" },
        "version": { "$ref": "#/definitions/semver" },
        "scope": { "$ref": "#/definitions/identifier" },
        "precedence": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "ruleCount": { "type": "integer", "minimum": 0, "maximum": 256 }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "winnerPath",
        "loserPath",
        "winnerPrecedence",
        "loserPrecedence"
      ],
      "properties": {
        "ruleId": { "$ref": "#/definitions/identifier" },
        "winnerPath": { "$ref": "#/definitions/policyPath" },
        "loserPath": { "$ref": "#/definitions/policyPath" },
        "winnerPrecedence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "loserPrecedence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    }
  }
}
