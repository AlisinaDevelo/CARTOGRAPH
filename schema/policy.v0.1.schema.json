{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/policy.v0.1.schema.json",
  "title": "CARTOGRAPH local policy configuration v0.1",
  "description": "A bounded, repository-local policy contract for node, edge, and diff constraints. It contains no executable or remote reference.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "version", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyId": { "$ref": "#/definitions/identifier" },
    "version": { "$ref": "#/definitions/semver" },
    "mode": {
      "enum": ["informational", "enforce"],
      "default": "informational",
      "description": "The default decision mode; informational is fail-open and is the default until evaluation is explicitly requested."
    },
    "scope": {
      "$ref": "#/definitions/identifier",
      "default": "repository",
      "description": "A bounded composition namespace. Contradictory selector outcomes in different scopes are evaluated independently."
    },
    "precedence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "default": 0,
      "description": "Higher precedence wins an explicitly authorized duplicate rule override."
    },
    "overrideLimit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128,
      "default": 0,
      "description": "Maximum number of lower-precedence duplicate rule IDs this policy may replace. Zero forbids overrides."
    },
    "includes": {
      "type": "array",
      "maxItems": 32,
      "default": [],
      "items": { "$ref": "#/definitions/include" },
      "description": "Repository-relative policy files composed offline before evaluation."
    },
    "exceptions": {
      "type": "array",
      "maxItems": 128,
      "default": [],
      "items": {},
      "description": "Versioned local exception records. The evaluator retains malformed records as visible findings instead of allowing them to suppress policy violations."
    },
    "adrBindings": {
      "type": "array",
      "maxItems": 128,
      "default": [],
      "items": {},
      "description": "Versioned local requirements that selected policy boundaries, exceptions, or planned violations carry a graph-backed ADR reference. Malformed records become visible policy findings."
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/definitions/rule" }
    }
  },
  "definitions": {
    "policyPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!~)(?!//)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$"
    },
    "include": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/definitions/policyPath" }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "adrReferenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "selectorValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "selectorName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "dateTime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "exceptionScope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "selector"],
          "properties": {
            "target": { "const": "node" },
            "selector": { "$ref": "#/definitions/nodeSelector" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "selector"],
          "properties": {
            "target": { "const": "edge" },
            "selector": { "$ref": "#/definitions/edgeSelector" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "selector"],
          "properties": {
            "target": { "const": "diff" },
            "selector": { "$ref": "#/definitions/diffSelector" }
          }
        }
      ]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "contract",
        "id",
        "ruleId",
        "scope",
        "rationale",
        "owner",
        "createdAt",
        "expiresAt"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contract": { "const": "cartograph.policy-exception" },
        "id": { "$ref": "#/definitions/identifier" },
        "ruleId": { "$ref": "#/definitions/identifier" },
        "scope": { "$ref": "#/definitions/exceptionScope" },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "owner": { "$ref": "#/definitions/identifier" },
        "createdAt": { "$ref": "#/definitions/dateTime" },
        "expiresAt": { "$ref": "#/definitions/dateTime" },
        "adrReferenceId": { "$ref": "#/definitions/adrReferenceId" },
        "precedence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 0
        }
      }
    },
    "adrBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "contract",
        "id",
        "ruleId",
        "requirement",
        "scope",
        "referenceId"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contract": { "const": "cartograph.policy-adr-binding" },
        "id": { "$ref": "#/definitions/identifier" },
        "ruleId": { "$ref": "#/definitions/identifier" },
        "requirement": {
          "enum": ["boundary", "exception", "planned-violation"]
        },
        "scope": { "$ref": "#/definitions/exceptionScope" },
        "referenceId": { "$ref": "#/definitions/adrReferenceId" }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "endpoint",
            "module",
            "package",
            "service",
            "function",
            "database_table",
            "queue",
            "external_service",
            "file",
            "unknown"
          ]
        },
        "id": { "$ref": "#/definitions/selectorValue" },
        "name": { "$ref": "#/definitions/selectorName" }
      },
      "anyOf": [
        { "required": ["kind"] },
        { "required": ["id"] },
        { "required": ["name"] }
      ]
    },
    "edgeSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "calls",
            "imports",
            "reads",
            "writes",
            "publishes",
            "subscribes",
            "requests",
            "contains",
            "routes_to",
            "depends_on",
            "implements",
            "unknown"
          ]
        },
        "from": { "$ref": "#/definitions/selectorValue" },
        "to": { "$ref": "#/definitions/selectorValue" }
      },
      "anyOf": [
        { "required": ["kind"] },
        { "required": ["from"] },
        { "required": ["to"] }
      ]
    },
    "diffSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "node-added",
            "node-removed",
            "node-changed",
            "edge-added",
            "edge-removed",
            "edge-changed",
            "edge-rewired",
            "diagnostic-added",
            "diagnostic-removed",
            "diagnostic-changed",
            "identity-matched",
            "identity-ambiguous",
            "identity-unsupported"
          ]
        },
        "id": { "$ref": "#/definitions/selectorValue" },
        "code": { "$ref": "#/definitions/identifier" },
        "classification": {
          "enum": [
            "node-changed",
            "edge-changed",
            "evidence-only",
            "confidence-changed",
            "endpoint-rewired",
            "diagnostic-changed"
          ]
        }
      },
      "anyOf": [
        { "required": ["kind"] },
        { "required": ["id"] },
        { "required": ["code"] },
        { "required": ["classification"] }
      ]
    },
    "ruleBase": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "assertion": {
          "enum": ["exists", "absent", "count-at-most", "count-at-least"]
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "effect": { "enum": ["informational", "enforce"] }
      },
      "required": ["id", "assertion"]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "assertion": {
          "enum": ["exists", "absent", "count-at-most", "count-at-least"]
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "effect": { "enum": ["informational", "enforce"] },
        "target": { "enum": ["node", "edge", "diff"] },
        "selector": { "type": "object" }
      },
      "required": ["id", "assertion", "target", "selector"],
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/definitions/ruleBase" },
            {
              "properties": {
                "target": { "const": "node" },
                "selector": { "$ref": "#/definitions/nodeSelector" }
              },
              "required": ["target", "selector"]
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/ruleBase" },
            {
              "properties": {
                "target": { "const": "edge" },
                "selector": { "$ref": "#/definitions/edgeSelector" }
              },
              "required": ["target", "selector"]
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/ruleBase" },
            {
              "properties": {
                "target": { "const": "diff" },
                "selector": { "$ref": "#/definitions/diffSelector" }
              },
              "required": ["target", "selector"]
            }
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "assertion": { "enum": ["count-at-most", "count-at-least"] }
            }
          },
          "then": { "required": ["value"] }
        },
        {
          "if": {
            "properties": {
              "assertion": { "enum": ["exists", "absent"] }
            }
          },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    }
  }
}
