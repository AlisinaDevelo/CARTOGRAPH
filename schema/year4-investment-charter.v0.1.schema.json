{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/year4-investment-charter.v0.1.schema.json",
  "title": "CARTOGRAPH conditional Year 4 investment charter v0.1",
  "description": "A public, capacity-gated decision record that selects maintenance-first OSS stewardship and defers Year 4 expansion until the required evidence and capacity gates are revisited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contract",
    "mediaType",
    "charterId",
    "asOf",
    "scope",
    "selectedTrack",
    "owners",
    "capacity",
    "gates",
    "outcomes",
    "quarters",
    "risks",
    "nonGoals",
    "summary",
    "provenance"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.year4-investment-charter" },
    "mediaType": {
      "const": "application/vnd.cartograph.year4-investment-charter+json"
    },
    "charterId": { "$ref": "#/definitions/identifier" },
    "asOf": { "$ref": "#/definitions/dateTime" },
    "scope": { "$ref": "#/definitions/scope" },
    "selectedTrack": { "$ref": "#/definitions/selectedTrack" },
    "owners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/definitions/owner" }
    },
    "capacity": { "$ref": "#/definitions/capacity" },
    "gates": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/definitions/gate" }
    },
    "outcomes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/definitions/outcome" }
    },
    "quarters": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/definitions/quarter" }
    },
    "risks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "items": { "$ref": "#/definitions/risk" }
    },
    "nonGoals": {
      "type": "array",
      "minItems": 6,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/text" }
    },
    "summary": { "$ref": "#/definitions/summary" },
    "provenance": { "$ref": "#/definitions/provenance" }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "dateTime": { "type": "string", "format": "date-time" },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!~)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
    },
    "digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/text" }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicOnly",
        "network",
        "sourceBodiesIncluded",
        "privateDataIncluded",
        "hiddenTelemetry",
        "sourceUpload",
        "accountRequired",
        "hostedExpansion"
      ],
      "properties": {
        "publicOnly": { "const": true },
        "network": { "const": false },
        "sourceBodiesIncluded": { "const": false },
        "privateDataIncluded": { "const": false },
        "hiddenTelemetry": { "const": false },
        "sourceUpload": { "const": false },
        "accountRequired": { "const": false },
        "hostedExpansion": { "const": "deferred" }
      }
    },
    "selectedTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "status",
        "fundingMode",
        "expansion",
        "description",
        "rationale",
        "evidenceRefs"
      ],
      "properties": {
        "id": { "const": "conditional-maintenance-first" },
        "category": { "const": "maintenance-track" },
        "status": { "const": "accepted" },
        "fundingMode": { "const": "unfunded-capacity-gated" },
        "expansion": { "const": "deferred" },
        "description": { "$ref": "#/definitions/text" },
        "rationale": { "$ref": "#/definitions/text" },
        "evidenceRefs": { "$ref": "#/definitions/evidenceRefs" }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "handle",
        "role",
        "status",
        "backupStatus",
        "responsibilities",
        "evidenceRefs"
      ],
      "properties": {
        "id": { "const": "primary-maintainer" },
        "handle": { "const": "@AlisinaDevelo" },
        "role": { "$ref": "#/definitions/text" },
        "status": { "const": "named" },
        "backupStatus": { "const": "documented-unverified" },
        "responsibilities": {
          "type": "array",
          "minItems": 4,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/text" }
        },
        "evidenceRefs": { "$ref": "#/definitions/evidenceRefs" }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "namedMaintainers",
        "verifiedBackups",
        "numericQuarterCommitment",
        "fundingStatus",
        "commitment",
        "capacityStatement",
        "evidenceRefs"
      ],
      "properties": {
        "status": { "const": "unmeasured" },
        "namedMaintainers": { "const": 1 },
        "verifiedBackups": { "const": 0 },
        "numericQuarterCommitment": { "type": "null" },
        "fundingStatus": { "const": "not-approved" },
        "commitment": { "const": "none" },
        "capacityStatement": { "$ref": "#/definitions/text" },
        "evidenceRefs": { "$ref": "#/definitions/evidenceRefs" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "decision",
        "digest",
        "limitations",
        "evidenceRefs"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "status": { "enum": ["accepted", "accepted-with-limitations"] },
        "decision": { "$ref": "#/definitions/text" },
        "digest": { "$ref": "#/definitions/digest" },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/text" }
        },
        "evidenceRefs": { "$ref": "#/definitions/evidenceRefs" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "objective",
        "ownerId",
        "capacityGate",
        "stopConditions",
        "evidenceRefs"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "status": { "const": "maintenance-only" },
        "objective": { "$ref": "#/definitions/text" },
        "ownerId": { "const": "primary-maintainer" },
        "capacityGate": { "const": "explicit-capacity-required" },
        "stopConditions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/text" }
        },
        "evidenceRefs": { "$ref": "#/definitions/evidenceRefs" }
      }
    },
    "quarter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "period",
        "status",
        "objective",
        "ownerId",
        "plannedOutcomeIds",
        "stopConditions",
        "evidenceRefs"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "period": { "$ref": "#/definitions/text" },
        "status": { "const": "maintenance-only" },
        "objective": { "$ref": "#/definitions/text" },
        "ownerId": { "const": "primary-maintainer" },
        "plannedOutcomeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/identifier" }
        },
        "stopConditions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/text" }
        },
        "evidenceRefs": { "$ref": "#/definitions/evidenceRefs" }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "status",
        "description",
        "mitigation",
        "evidenceRefs"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "severity": { "enum": ["high", "medium", "low"] },
        "status": { "enum": ["open", "accepted-residual", "deferred"] },
        "description": { "$ref": "#/definitions/text" },
        "mitigation": { "$ref": "#/definitions/text" },
        "evidenceRefs": { "$ref": "#/definitions/evidenceRefs" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedTrack",
        "gateCount",
        "outcomeCount",
        "quarterCount",
        "riskCount",
        "nonGoalCount",
        "hostedExpansion",
        "fundedTeamScale",
        "ossHardeningBeyondMaintenance",
        "capacityStatus",
        "network",
        "sourceBodiesIncluded",
        "privateDataIncluded",
        "hiddenTelemetry"
      ],
      "properties": {
        "selectedTrack": { "const": "conditional-maintenance-first" },
        "gateCount": { "const": 6 },
        "outcomeCount": { "const": 4 },
        "quarterCount": { "const": 4 },
        "riskCount": { "const": 5 },
        "nonGoalCount": { "const": 8 },
        "hostedExpansion": { "const": "deferred" },
        "fundedTeamScale": { "const": false },
        "ossHardeningBeyondMaintenance": { "const": false },
        "capacityStatus": { "const": "unmeasured" },
        "network": { "const": false },
        "sourceBodiesIncluded": { "const": false },
        "privateDataIncluded": { "const": false },
        "hiddenTelemetry": { "const": false }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reference", "transformation", "redistribution"],
      "properties": {
        "source": { "$ref": "#/definitions/text" },
        "reference": { "$ref": "#/definitions/text" },
        "transformation": { "$ref": "#/definitions/text" },
        "redistribution": { "const": "allowed" }
      }
    }
  }
}
