{
  "schemaVersion": 1,
  "contract": "cartograph.runtime-trace-safety",
  "mediaType": "application/vnd.cartograph.runtime-trace-safety+json",
  "redaction": {
    "fields": [
      "span.name",
      "span.serviceName",
      "span.scopeName",
      "span.scopeVersion"
