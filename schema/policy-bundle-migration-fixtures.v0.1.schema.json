{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/policy-bundle-migration-fixtures.v0.1.schema.json",
  "title": "CARTOGRAPH policy-bundle migration fixtures v0.1",
  "description": "Scenario metadata for deterministic policy-bundle migration checks without duplicating policy source content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseBundlePath", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseBundlePath": { "$ref": "#/definitions/portablePath" },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/definitions/case" }
    }
  },
  "definitions": {
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\\\)(?!~)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenario", "expectedCodes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "scenario": {
          "enum": [
            "version-upgrade",
            "expiry",
            "revocation",
            "incompatible-selector",
            "missing-owner"
          ]
        },
        "targetPolicyVersion": { "$ref": "#/definitions/semver" },
        "now": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "revokedDigests": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/digest" }
        },
        "selector": { "type": "string", "minLength": 1, "maxLength": 512 },
        "ownerPresent": { "type": "boolean" },
        "expectedCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "version-upgrade",
              "expired",
              "revoked",
              "incompatible-selector",
              "missing-owner"
            ]
          }
        }
      }
    }
  }
}
