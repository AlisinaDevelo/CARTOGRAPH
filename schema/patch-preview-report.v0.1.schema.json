{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/patch-preview-report.v0.1.schema.json",
  "title": "CARTOGRAPH isolated patch preview report v0.1",
  "description": "Exact source provenance and digest-only results for a temporary patch preview; it never authorizes application.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "previewId",
    "sourceRef",
    "sourceCommit",
    "requestDigest",
    "originalStatusDigest",
    "originalDirty",
    "status",
    "operations",
    "validation",
    "conflictPath",
    "errorCode",
    "worktreePreserved",
    "requiresExplicitApplication",
    "rollbackInstructions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.patch-preview" },
    "previewId": { "$ref": "#/definitions/identifier" },
    "sourceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "anyOf": [{ "pattern": "^-" }, { "pattern": "[\\u0000\\r\\n]" }]
      }
    },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "requestDigest": { "$ref": "#/definitions/digest" },
    "originalStatusDigest": { "$ref": "#/definitions/digest" },
    "originalDirty": { "type": "boolean" },
    "status": { "enum": ["passed", "conflict", "validation-failed"] },
    "operations": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/definitions/appliedOperation" }
    },
    "validation": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/definitions/validation" }
    },
    "conflictPath": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/path" }]
    },
    "errorCode": {
      "anyOf": [
        { "type": "null" },
        {
          "enum": [
            "path-conflict",
            "digest-conflict",
            "invalid-target",
            "validation-failed"
          ]
        }
      ]
    },
    "worktreePreserved": { "const": true },
    "requiresExplicitApplication": { "const": true },
    "rollbackInstructions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![\\\\/])(?!~)(?![A-Za-z][A-Za-z\\d+.-]*:)(?!.*[\\u0000])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!^\\.?$).+"
    },
    "appliedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "beforeDigest", "afterDigest"],
      "properties": {
        "path": { "$ref": "#/definitions/path" },
        "beforeDigest": { "$ref": "#/definitions/digest" },
        "afterDigest": { "$ref": "#/definitions/digest" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status", "outputDigest", "detail"],
      "properties": {
        "command": { "enum": ["verify-patch", "node-version", "npm-version"] },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "outputDigest": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/digest" }]
        },
        "detail": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
