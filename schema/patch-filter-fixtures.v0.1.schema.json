{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/patch-filter-fixtures.v0.1.schema.json",
  "title": "CARTOGRAPH patch-filter fixture descriptor v0.1",
  "description": "Local scenario references and expected summaries for patch-scoped graph filtering.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contract",
    "fixtureId",
    "before",
    "after",
    "request",
    "policy",
    "expected"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.patch-filter-fixtures" },
    "fixtureId": { "$ref": "#/definitions/identifier" },
    "before": { "$ref": "#/definitions/path" },
    "after": { "$ref": "#/definitions/path" },
    "request": { "$ref": "#/definitions/request" },
    "policy": { "$ref": "#/definitions/policy" },
    "expected": { "$ref": "#/definitions/expected" }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/|%=>-]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![\\\\/])(?!~)(?![A-Za-z][A-Za-z\\d+.-]*:)(?!.*\\u0000)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"
    },
    "changedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "generated"],
      "properties": {
        "path": { "$ref": "#/definitions/path" },
        "status": { "enum": ["added", "modified", "removed", "renamed"] },
        "previousPath": { "$ref": "#/definitions/path" },
        "generated": { "type": "boolean" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "contract",
        "filterId",
        "changedFiles",
        "contextDepth",
        "includeGenerated",
        "maxNodes",
        "maxEdges",
        "maxDiagnostics",
        "maxOmittedRegions"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contract": { "const": "cartograph.patch-filter" },
        "filterId": { "$ref": "#/definitions/identifier" },
        "changedFiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": { "$ref": "#/definitions/changedFile" }
        },
        "contextDepth": { "type": "integer", "minimum": 0, "maximum": 1 },
        "includeGenerated": { "type": "boolean" },
        "maxNodes": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxEdges": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxDiagnostics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxOmittedRegions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "policyId", "version", "mode", "rules"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "policyId": { "$ref": "#/definitions/identifier" },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "mode": { "enum": ["informational", "enforce"] },
        "rules": { "type": "array", "minItems": 1 }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beforeNodeIds",
        "afterNodeIds",
        "beforeEdgeIds",
        "afterEdgeIds",
        "generatedOmittedFiles",
        "renameIdentity",
        "policyStatus",
        "omittedViolationCount",
        "deterministic",
        "readOnly"
      ],
      "properties": {
        "beforeNodeIds": {
          "type": "array",
          "items": { "$ref": "#/definitions/identifier" }
        },
        "afterNodeIds": {
          "type": "array",
          "items": { "$ref": "#/definitions/identifier" }
        },
        "beforeEdgeIds": {
          "type": "array",
          "items": { "$ref": "#/definitions/identifier" }
        },
        "afterEdgeIds": {
          "type": "array",
          "items": { "$ref": "#/definitions/identifier" }
        },
        "generatedOmittedFiles": {
          "type": "array",
          "items": { "$ref": "#/definitions/path" }
        },
        "renameIdentity": { "$ref": "#/definitions/identifier" },
        "policyStatus": {
          "enum": ["not-provided", "passed", "violations", "unsupported"]
        },
        "omittedViolationCount": { "type": "integer", "minimum": 0 },
        "deterministic": { "const": true },
        "readOnly": { "const": true }
      }
    }
  }
}
