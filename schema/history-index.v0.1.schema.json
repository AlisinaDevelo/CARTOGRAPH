{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/history-index.v0.1.schema.json",
  "title": "CARTOGRAPH history store index v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.history-store" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "recordSchemaVersion", "references"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "kind": {
            "enum": [
              "snapshot",
              "diff",
              "policy",
              "decisions",
              "finding-lifecycle",
              "workspace-composition",
              "provenance"
            ]
          },
          "recordSchemaVersion": { "type": "integer", "minimum": 0 },
          "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
          "references": {
            "type": "array",
            "maxItems": 64,
            "items": { "$ref": "#/definitions/reference" }
          }
        }
      }
    }
  },
  "definitions": {
    "reference": {
      "type": "string",
      "pattern": "^(?:revision:[0-9a-zA-Z._-]{1,128}|record:[0-9a-f]{64})$"
    }
  }
}
