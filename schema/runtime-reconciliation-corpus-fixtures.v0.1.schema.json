{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/runtime-reconciliation-corpus-fixtures.v0.1.schema.json",
  "title": "CARTOGRAPH runtime reconciliation corpus fixtures v0.1",
  "description": "Offline, family-labeled synthetic static/runtime cases with explicit expected classifications and provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contract",
    "mediaType",
    "fixtureId",
    "evaluatedAt",
    "baseInput",
    "releaseGating",
    "limitations",
    "cases"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "contract": {
      "const": "cartograph.runtime-reconciliation-corpus-fixtures"
    },
    "mediaType": {
      "const": "application/vnd.cartograph.runtime-reconciliation-corpus-fixtures+json"
    },
    "fixtureId": { "$ref": "#/definitions/identifier" },
    "evaluatedAt": { "$ref": "#/definitions/dateTime" },
    "baseInput": { "$ref": "#/definitions/path" },
    "releaseGating": { "$ref": "#/definitions/releaseGating" },
    "limitations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": { "$ref": "#/definitions/text" }
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 32,
      "items": { "$ref": "#/definitions/case" }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "dateTime": { "type": "string", "format": "date-time" },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:[a-zA-Z0-9_.-]+/)*[a-zA-Z0-9_.-]+$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 1600 },
    "spanKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}:[0-9a-f]{16}$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "edgeId": {
      "type": "string",
      "pattern": "^edge:.+$"
    },
    "releaseGating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "reason"],
      "properties": {
        "enabled": { "const": false },
        "reason": { "$ref": "#/definitions/text" }
      }
    },
    "family": {
      "enum": [
        "http",
        "database",
        "messaging",
        "errors",
        "missing-parents",
        "sampling",
        "redaction",
        "static-runtime-disagreement"
      ]
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "expectedSpanCount",
        "observedSpanCount",
        "missingIsNotAbsence",
        "rationale"
      ],
      "properties": {
        "strategy": {
          "enum": ["complete", "head", "tail", "probabilistic"]
        },
        "expectedSpanCount": { "type": "integer", "minimum": 0 },
        "observedSpanCount": { "type": "integer", "minimum": 0 },
        "missingIsNotAbsence": { "const": true },
        "rationale": { "$ref": "#/definitions/text" }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "fields", "replacement"],
      "properties": {
        "enabled": { "type": "boolean" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "span.name",
              "span.serviceName",
              "span.scopeName",
              "span.scopeVersion"
            ]
          }
        },
        "replacement": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "license",
        "reference",
        "transformation",
        "redistribution"
      ],
      "properties": {
        "source": { "$ref": "#/definitions/text" },
        "license": { "const": "Apache-2.0" },
        "reference": { "$ref": "#/definitions/text" },
        "transformation": { "$ref": "#/definitions/text" },
        "redistribution": { "const": "allowed" }
      }
    },
    "classificationCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed-and-modeled",
        "modeled-not-observed",
        "observed-but-unmodeled",
        "ambiguous"
      ],
      "properties": {
        "observed-and-modeled": { "type": "integer", "minimum": 0 },
        "modeled-not-observed": { "type": "integer", "minimum": 0 },
        "observed-but-unmodeled": { "type": "integer", "minimum": 0 },
        "ambiguous": { "type": "integer", "minimum": 0 }
      }
    },
    "expectedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "classification"],
      "properties": {
        "id": { "$ref": "#/definitions/text" },
        "classification": {
          "enum": [
            "observed-and-modeled",
            "modeled-not-observed",
            "observed-but-unmodeled",
            "ambiguous"
          ]
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classificationCounts", "records"],
      "properties": {
        "classificationCounts": {
          "$ref": "#/definitions/classificationCounts"
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200000,
          "items": { "$ref": "#/definitions/expectedRecord" }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "families",
        "traceIds",
        "staticEdgeIds",
        "dropSpanIds",
        "dropBindingSpanIds",
        "sampling",
        "redaction",
        "provenance",
        "expected"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "description": { "$ref": "#/definitions/text" },
        "families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/family" }
        },
        "traceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/traceId" }
        },
        "staticEdgeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/edgeId" }
        },
        "dropSpanIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/spanKey" }
        },
        "dropBindingSpanIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/spanKey" }
        },
        "sampling": { "$ref": "#/definitions/sampling" },
        "redaction": { "$ref": "#/definitions/redaction" },
        "provenance": { "$ref": "#/definitions/provenance" },
        "expected": { "$ref": "#/definitions/expected" }
      }
    }
  }
}
