{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/runtime-reconciliation-uncertainty-fixtures.v0.1.schema.json",
  "title": "CARTOGRAPH runtime reconciliation uncertainty fixtures v0.1",
  "description": "Synthetic sampling, clock, alias, missing-parent, and confidence scenarios for local runtime reconciliation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contract",
    "fixtureId",
    "evaluatedAt",
    "baseInput",
    "limitations",
    "samplingCaveats",
    "cases"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "contract": {
      "const": "cartograph.runtime-reconciliation-uncertainty-fixtures"
    },
    "fixtureId": { "$ref": "#/definitions/identifier" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "baseInput": { "$ref": "#/definitions/path" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/text" }
    },
    "samplingCaveats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/text" }
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/definitions/case" }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?:[a-zA-Z0-9_.-]+/)*[a-zA-Z0-9_.-]+$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 1600 },
    "traceKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}:[0-9a-f]{16}$"
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "expectedSpanCount",
        "observedSpanCount",
        "observedRate",
        "missingIsNotAbsence",
        "rationale"
      ],
      "properties": {
        "strategy": { "enum": ["complete", "head", "tail", "probabilistic"] },
        "expectedSpanCount": { "type": "integer", "minimum": 0 },
        "observedSpanCount": { "type": "integer", "minimum": 0 },
        "observedRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "missingIsNotAbsence": { "const": true },
        "rationale": { "$ref": "#/definitions/text" }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "offsetNanoseconds",
        "uncertaintyNanoseconds",
        "ordering",
        "rationale"
      ],
      "properties": {
        "domain": { "enum": ["trace", "service-local", "unknown"] },
        "offsetNanoseconds": { "type": "integer" },
        "uncertaintyNanoseconds": { "type": "integer", "minimum": 0 },
        "ordering": { "enum": ["exact", "bounded", "unknown"] },
        "rationale": { "$ref": "#/definitions/text" }
      }
    },
    "serviceAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "aliases"],
      "properties": {
        "canonical": { "$ref": "#/definitions/identifier" },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/identifier" }
        }
      }
    },
    "missingParent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId", "parentSpanId", "childSpanId", "reason"],
      "properties": {
        "traceId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "parentSpanId": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "childSpanId": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "reason": { "$ref": "#/definitions/text" }
      }
    },
    "confidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certainWhen", "inferredWhen", "unknownWhen"],
      "properties": {
        "certainWhen": { "$ref": "#/definitions/text" },
        "inferredWhen": { "$ref": "#/definitions/text" },
        "unknownWhen": { "$ref": "#/definitions/text" }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampling",
        "clock",
        "serviceAliases",
        "missingParents",
        "confidencePolicy"
      ],
      "properties": {
        "sampling": { "$ref": "#/definitions/sampling" },
        "clock": { "$ref": "#/definitions/clock" },
        "serviceAliases": {
          "type": "array",
          "items": { "$ref": "#/definitions/serviceAlias" }
        },
        "missingParents": {
          "type": "array",
          "items": { "$ref": "#/definitions/missingParent" }
        },
        "confidencePolicy": { "$ref": "#/definitions/confidencePolicy" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject",
        "from",
        "to",
        "reasonCode",
        "explanation"
      ],
      "properties": {
        "kind": { "enum": ["classification", "confidence"] },
        "subject": { "$ref": "#/definitions/text" },
        "from": { "type": ["string", "null"] },
        "to": { "type": ["string", "null"] },
        "reasonCode": {
          "enum": ["sampling", "clock", "missing-parent", "binding-confidence"]
        },
        "explanation": { "$ref": "#/definitions/text" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classificationCounts", "confidenceCounts", "changes"],
      "properties": {
        "classificationCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed-and-modeled",
            "modeled-not-observed",
            "observed-but-unmodeled",
            "ambiguous"
          ],
          "properties": {
            "observed-and-modeled": { "type": "integer", "minimum": 0 },
            "modeled-not-observed": { "type": "integer", "minimum": 0 },
            "observed-but-unmodeled": { "type": "integer", "minimum": 0 },
            "ambiguous": { "type": "integer", "minimum": 0 }
          }
        },
        "confidenceCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["certain", "inferred", "unknown"],
          "properties": {
            "certain": { "type": "integer", "minimum": 0 },
            "inferred": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 }
          }
        },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/definitions/change" }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "dropSpanIds",
        "dropBindingSpanIds",
        "uncertainty",
        "expected"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "description": { "$ref": "#/definitions/text" },
        "dropSpanIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/traceKey" }
        },
        "dropBindingSpanIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/traceKey" }
        },
        "uncertainty": { "$ref": "#/definitions/uncertainty" },
        "expected": { "$ref": "#/definitions/expected" }
      }
    }
  }
}
