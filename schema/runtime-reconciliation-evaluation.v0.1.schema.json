{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/runtime-reconciliation-evaluation.v0.1.schema.json",
  "title": "CARTOGRAPH runtime reconciliation evaluation report v0.1",
  "description": "Offline precision, recall, runtime-edge coverage, and ambiguity report for synthetic static/runtime reconciliation cases.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "mediaType",
    "evaluationId",
    "evaluatedAt",
    "fixtureDigest",
    "releaseGating",
    "limitations",
    "samplingCaveats",
    "overall",
    "caseResults",
    "reportDigest"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.runtime-reconciliation-evaluation" },
    "mediaType": {
      "const": "application/vnd.cartograph.runtime-reconciliation-evaluation+json"
    },
    "evaluationId": { "$ref": "#/definitions/identifier" },
    "evaluatedAt": { "$ref": "#/definitions/dateTime" },
    "fixtureDigest": { "$ref": "#/definitions/digest" },
    "releaseGating": { "$ref": "#/definitions/releaseGating" },
    "limitations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "samplingCaveats": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "overall": { "$ref": "#/definitions/metrics" },
    "caseResults": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "allOf": [
          { "$ref": "#/definitions/metrics" },
          {
            "type": "object",
            "required": ["id"],
            "properties": { "id": { "$ref": "#/definitions/identifier" } }
          }
        ]
      }
    },
    "reportDigest": { "$ref": "#/definitions/digest" }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "dateTime": { "type": "string", "minLength": 1, "maxLength": 64 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "releaseGating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "reason"],
      "properties": {
        "enabled": { "const": false },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedRuntimeSpanEdges",
        "actualRuntimeSpanEdges",
        "expectedRecords",
        "actualRecords",
        "truePositives",
        "falsePositives",
        "falseNegatives",
        "precision",
        "recall",
        "coverage",
        "ambiguousRecords",
        "ambiguityRate"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "expectedRuntimeSpanEdges": { "type": "integer", "minimum": 0 },
        "actualRuntimeSpanEdges": { "type": "integer", "minimum": 0 },
        "expectedRecords": { "type": "integer", "minimum": 0 },
        "actualRecords": { "type": "integer", "minimum": 0 },
        "truePositives": { "type": "integer", "minimum": 0 },
        "falsePositives": { "type": "integer", "minimum": 0 },
        "falseNegatives": { "type": "integer", "minimum": 0 },
        "precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "ambiguousRecords": { "type": "integer", "minimum": 0 },
        "ambiguityRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
