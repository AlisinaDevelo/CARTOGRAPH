{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/assurance-bundle.v0.1.schema.json",
  "title": "CARTOGRAPH assurance bundle manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "bundleId",
    "tool",
    "limits",
    "requiredRoles",
    "artifacts",
    "missing",
    "sourceBodiesIncluded"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.assurance-bundle" },
    "bundleId": { "$ref": "#/definitions/digest" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "cartograph-cli" },
        "version": { "$ref": "#/definitions/text" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxArtifacts", "maxArtifactBytes", "maxTotalBytes"],
      "properties": {
        "maxArtifacts": { "const": 128 },
        "maxArtifactBytes": { "const": 67108864 },
        "maxTotalBytes": { "const": 536870912 }
      }
    },
    "requiredRoles": {
      "type": "array",
      "maxItems": 15,
      "items": { "$ref": "#/definitions/role" }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "mediaType", "sha256", "bytes"],
        "properties": {
          "role": { "$ref": "#/definitions/role" },
          "path": {
            "type": "string",
            "pattern": "^artifacts/[a-z0-9-]+-[0-9a-f]{12}\\.(?:json|html|md|sarif)$"
          },
          "mediaType": {
            "enum": [
              "application/json",
              "text/html",
              "text/markdown",
              "application/sarif+json"
            ]
          },
          "sha256": { "$ref": "#/definitions/digest" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
          "label": { "$ref": "#/definitions/text" }
        }
      }
    },
    "missing": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "reason"],
        "properties": {
          "role": { "$ref": "#/definitions/role" },
          "reason": { "$ref": "#/definitions/text" }
        }
      }
    },
    "sourceBodiesIncluded": { "const": false }
  },
  "definitions": {
    "role": {
      "enum": [
        "snapshot-base",
        "snapshot-head",
        "diff",
        "policy",
        "policy-evaluation",
        "decisions",
        "finding-lifecycle",
        "waiver",
        "query-result",
        "review-summary",
        "configuration",
        "adapter-manifest",
        "report-html",
        "report-markdown",
        "report-sarif"
      ]
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000\\r\\n]+$"
    }
  }
}
