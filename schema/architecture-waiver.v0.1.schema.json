{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/architecture-waiver.v0.1.schema.json",
  "title": "CARTOGRAPH locally verifiable architecture waiver v0.1",
  "description": "An expiry-bound, repository-local architecture waiver bound to one policy rule, one canonical input digest, exact affected graph identities, evidence revision, explicit approver, and declared local trust roots. Private keys and authority are outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "mediaType",
    "id",
    "ruleId",
    "scope",
    "changeScope",
    "rationale",
    "owner",
    "approver",
    "createdAt",
    "expiresAt",
    "policyVersion",
    "evidenceRevision",
    "evidenceRefs",
    "trustRootIds",
    "authority",
    "precedence",
    "digest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.architecture-waiver" },
    "mediaType": {
      "const": "application/vnd.cartograph.architecture-waiver+json"
    },
    "id": { "$ref": "#/definitions/identifier" },
    "ruleId": { "$ref": "#/definitions/identifier" },
    "scope": { "$ref": "#/definitions/scope" },
    "changeScope": { "$ref": "#/definitions/changeScope" },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "owner": { "$ref": "#/definitions/identifier" },
    "approver": { "$ref": "#/definitions/identifier" },
    "createdAt": { "$ref": "#/definitions/dateTime" },
    "expiresAt": { "$ref": "#/definitions/dateTime" },
    "policyVersion": { "$ref": "#/definitions/semver" },
    "evidenceRevision": { "$ref": "#/definitions/identifier" },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/definitions/evidenceReference" }
    },
    "trustRootIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/definitions/identifier" }
    },
    "authority": { "const": "none" },
    "precedence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "digest": { "$ref": "#/definitions/digest" },
    "signature": { "$ref": "#/definitions/signature" }
  },
  "allOf": [
    {
      "if": { "required": ["createdAt", "expiresAt"] },
      "then": {
        "properties": {
          "expiresAt": { "format": "date-time" }
        }
      }
    }
  ],
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "dateTime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "evidenceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "selectorValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "selectorName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "endpoint",
            "module",
            "package",
            "service",
            "function",
            "database_table",
            "queue",
            "external_service",
            "file",
            "unknown"
          ]
        },
        "id": { "$ref": "#/definitions/selectorValue" },
        "name": { "$ref": "#/definitions/selectorName" }
      },
      "anyOf": [
        { "required": ["kind"] },
        { "required": ["id"] },
        { "required": ["name"] }
      ]
    },
    "edgeSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "calls",
            "imports",
            "reads",
            "writes",
            "publishes",
            "subscribes",
            "requests",
            "contains",
            "routes_to",
            "depends_on",
            "implements",
            "unknown"
          ]
        },
        "from": { "$ref": "#/definitions/selectorValue" },
        "to": { "$ref": "#/definitions/selectorValue" }
      },
      "anyOf": [
        { "required": ["kind"] },
        { "required": ["from"] },
        { "required": ["to"] }
      ]
    },
    "diffSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "node-added",
            "node-removed",
            "node-changed",
            "edge-added",
            "edge-removed",
            "edge-changed",
            "edge-rewired",
            "diagnostic-added",
            "diagnostic-removed",
            "diagnostic-changed",
            "identity-matched",
            "identity-ambiguous",
            "identity-unsupported"
          ]
        },
        "id": { "$ref": "#/definitions/selectorValue" },
        "code": { "$ref": "#/definitions/identifier" },
        "classification": {
          "enum": [
            "node-changed",
            "edge-changed",
            "evidence-only",
            "confidence-changed",
            "endpoint-rewired",
            "diagnostic-changed"
          ]
        }
      },
      "anyOf": [
        { "required": ["kind"] },
        { "required": ["id"] },
        { "required": ["code"] },
        { "required": ["classification"] }
      ]
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "selector"],
          "properties": {
            "target": { "const": "node" },
            "selector": { "$ref": "#/definitions/nodeSelector" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "selector"],
          "properties": {
            "target": { "const": "edge" },
            "selector": { "$ref": "#/definitions/edgeSelector" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "selector"],
          "properties": {
            "target": { "const": "diff" },
            "selector": { "$ref": "#/definitions/diffSelector" }
          }
        }
      ]
    },
    "changeScope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputKind", "inputDigest", "affectedIds"],
          "properties": {
            "inputKind": { "const": "snapshot" },
            "inputDigest": { "$ref": "#/definitions/digest" },
            "affectedIds": {
              "type": "array",
              "maxItems": 10000,
              "items": { "$ref": "#/definitions/identifier" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputKind",
            "inputDigest",
            "baselineDigest",
            "candidateDigest",
            "affectedIds"
          ],
          "properties": {
            "inputKind": { "const": "diff" },
            "inputDigest": { "$ref": "#/definitions/digest" },
            "baselineDigest": { "$ref": "#/definitions/digest" },
            "candidateDigest": { "$ref": "#/definitions/digest" },
            "affectedIds": {
              "type": "array",
              "maxItems": 10000,
              "items": { "$ref": "#/definitions/identifier" }
            }
          }
        }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "contract",
        "manifestDigest",
        "signerKeyId",
        "algorithm",
        "algorithmVersion",
        "signature",
        "signedAt",
        "expiresAt"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contract": { "const": "cartograph.assurance-signing" },
        "manifestDigest": { "$ref": "#/definitions/digest" },
        "signerKeyId": { "$ref": "#/definitions/identifier" },
        "algorithm": { "type": "string", "minLength": 1, "maxLength": 64 },
        "algorithmVersion": { "type": "integer", "minimum": 1 },
        "signature": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "signedAt": { "$ref": "#/definitions/dateTime" },
        "expiresAt": { "$ref": "#/definitions/dateTime" }
      }
    }
  }
}
