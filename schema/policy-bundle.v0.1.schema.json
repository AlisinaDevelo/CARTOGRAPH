{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/policy-bundle.v0.1.schema.json",
  "title": "CARTOGRAPH digest-bound policy bundle v0.1",
  "description": "An offline, declarative policy bundle with a content digest, compatibility contract, expiry, and deny-only authority boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "policy",
    "compatibility",
    "owner",
    "createdAt",
    "expiresAt",
    "authority"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bundleId": { "$ref": "#/definitions/identifier" },
    "policy": { "$ref": "#/definitions/policy" },
    "compatibility": { "$ref": "#/definitions/compatibility" },
    "owner": { "type": "string", "minLength": 1, "maxLength": 240 },
    "createdAt": { "$ref": "#/definitions/dateTime" },
    "expiresAt": { "$ref": "#/definitions/dateTime" },
    "authority": { "$ref": "#/definitions/authority" }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!\\\\)(?!~)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\.\\.)[^\\u0000]+$"
    },
    "dateTime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "selector", "assertion", "effect"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "target": { "enum": ["node", "edge", "diff"] },
        "selector": { "type": "string", "minLength": 1, "maxLength": 512 },
        "assertion": {
          "enum": ["exists", "absent", "count-at-most", "count-at-least"]
        },
        "effect": { "enum": ["informational", "enforce"] },
        "value": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assertion": { "enum": ["count-at-most", "count-at-least"] }
            }
          },
          "then": { "required": ["value"] }
        },
        {
          "if": {
            "properties": { "assertion": { "enum": ["exists", "absent"] } }
          },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType", "digest", "rules"],
      "properties": {
        "path": { "$ref": "#/definitions/portablePath" },
        "mediaType": { "const": "application/vnd.cartograph.policy+json" },
        "digest": { "$ref": "#/definitions/digest" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/definitions/rule" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "source": { "$ref": "#/definitions/source" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "bundleVersion",
        "graphSnapshotSchemaVersion",
        "graphDiffSchemaVersion",
        "capabilityRegistryVersion"
      ],
      "properties": {
        "contract": { "type": "string", "minLength": 1, "maxLength": 160 },
        "bundleVersion": { "type": "integer", "minimum": 1 },
        "graphSnapshotSchemaVersion": { "type": "integer", "minimum": 1 },
        "graphDiffSchemaVersion": { "type": "integer", "minimum": 1 },
        "capabilityRegistryVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "filesystem", "execution"],
      "properties": {
        "network": { "const": false },
        "filesystem": { "const": false },
        "execution": { "const": false }
      }
    }
  }
}
