{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/release-compatibility-record.v0.1.schema.json",
  "title": "CARTOGRAPH release compatibility record v0.1",
  "description": "Machine-readable record of the compatibility matrix bound to a release artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "matrixId",
    "matrixDigest",
    "package",
    "sourceCommit",
    "testedBy",
    "runtime",
    "contracts",
    "actions",
    "testedCombinations",
    "result"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.release-compatibility-record" },
    "matrixId": { "type": "string", "minLength": 1 },
    "matrixDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "tag"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "testedBy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "npm", "platform", "arch"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "npm": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot",
        "diff",
        "policy",
        "adapterApi",
        "adapterCompatibility",
        "action"
      ],
      "properties": {
        "snapshot": { "type": "integer", "minimum": 1 },
        "diff": { "type": "integer", "minimum": 1 },
        "policy": { "type": "integer", "minimum": 1 },
        "adapterApi": { "type": "integer", "minimum": 1 },
        "adapterCompatibility": { "type": "integer", "minimum": 1 },
        "action": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "ref"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": {
            "type": "string",
            "pattern": "^v[0-9]+(?:\\.[0-9]+){1,2}$"
          },
          "ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    },
    "testedCombinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "os",
          "node",
          "snapshot",
          "diff",
          "policy",
          "adapterApi",
          "adapterCompatibility",
          "action"
        ],
        "properties": {
          "os": { "type": "string", "minLength": 1 },
          "node": { "type": "string", "pattern": "^[0-9]+\\.x$" },
          "snapshot": { "type": "integer", "minimum": 1 },
          "diff": { "type": "integer", "minimum": 1 },
          "policy": { "type": "integer", "minimum": 1 },
          "adapterApi": { "type": "integer", "minimum": 1 },
          "adapterCompatibility": { "type": "integer", "minimum": 1 },
          "action": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      }
    },
    "result": { "const": "passed" }
  }
}
