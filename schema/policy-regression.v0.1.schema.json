{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/policy-regression.v0.1.schema.json",
  "title": "CARTOGRAPH policy regression fixture v0.1",
  "description": "Offline positive and negative policy cases with published false-positive, false-negative, explanation, and evidence baselines.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contract",
    "fixtureId",
    "baseline",
    "requiredRuleTypes",
    "snapshots",
    "diffs",
    "cases"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.policy-regression" },
    "fixtureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
    },
    "baseline": {
      "$ref": "#/$defs/counts"
    },
    "requiredRuleTypes": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(node|edge|diff):[a-z-]+$" }
    },
    "snapshots": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "object" }
    },
    "diffs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["before", "after"],
        "properties": {
          "before": { "type": "string", "minLength": 1 },
          "after": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "falsePositives",
        "falseNegatives",
        "explanationRegressions",
        "evidenceRegressions"
      ],
      "properties": {
        "falsePositives": { "type": "integer", "minimum": 0 },
        "falseNegatives": { "type": "integer", "minimum": 0 },
        "explanationRegressions": { "type": "integer", "minimum": 0 },
        "evidenceRegressions": { "type": "integer", "minimum": 0 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "input", "policy", "expected"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "class": { "enum": ["positive", "negative", "unsupported"] },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref"],
          "properties": {
            "kind": { "enum": ["snapshot", "diff"] },
            "ref": { "type": "string", "minLength": 1 }
          }
        },
        "policy": { "type": "object", "minProperties": 1 },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "violationIds", "unsupportedIds"],
          "properties": {
            "status": { "enum": ["passed", "violations", "unsupported"] },
            "violationIds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "unsupportedIds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "checks": {
              "type": "array",
              "items": { "$ref": "#/$defs/check" }
            }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["violation", "unsupported"] },
        "id": { "type": "string", "minLength": 1 },
        "reasonIncludes": { "type": "string", "minLength": 1 },
        "evidenceIncludes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
