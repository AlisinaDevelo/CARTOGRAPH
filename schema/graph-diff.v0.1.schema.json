{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/graph-diff.v0.1.schema.json",
  "title": "CARTOGRAPH GraphDiff v0.1",
  "description": "Canonical, portable machine-readable architecture changes between two GraphSnapshot revisions. Runtime validation additionally checks summary counts, identities, canonical ordering, and deterministic endpoint-rewire classifications.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "summary",
    "fromRevision",
    "toRevision",
    "nodes",
    "edges",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "CARTOGRAPH GraphDiff schema version 0.1."
    },
    "capabilityRegistryVersion": {
      "const": 1,
      "description": "Version of the extractor capability and unknown-semantics registry used by both snapshots."
    },
    "summary": {
      "$ref": "#/definitions/summary"
    },
    "comparison": {
      "$ref": "#/definitions/comparison"
    },
    "topology": {
      "$ref": "#/definitions/topology"
    },
    "fromRevision": {
      "$ref": "#/definitions/revision"
    },
    "toRevision": {
      "$ref": "#/definitions/revision"
    },
    "nodes": {
      "$ref": "#/definitions/nodeChanges"
    },
    "identity": {
      "$ref": "#/definitions/identityChanges"
    },
    "edges": {
      "$ref": "#/definitions/edgeChanges"
    },
    "diagnostics": {
      "$ref": "#/definitions/diagnosticChanges"
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "description": "A non-empty stable identifier. Runtime validation trims surrounding whitespace."
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!~)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$",
      "description": "A normalized POSIX repository-relative path; it cannot escape the repository or name a local absolute path."
    },
    "portableReference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\\\)(?!~)(?![A-Za-z]:)(?!file:)(?!.*\\u0000).+$",
      "description": "A portable reference that does not disclose an absolute local path."
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line"],
      "properties": {
        "path": { "$ref": "#/definitions/portablePath" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitSha"],
      "properties": {
        "commitSha": { "$ref": "#/definitions/identifier" },
        "parentSha": { "$ref": "#/definitions/identifier" },
        "branch": { "$ref": "#/definitions/identifier" },
        "authoredAt": { "$ref": "#/definitions/dateTime" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "baseRef",
        "headRef",
        "baseCommitSha",
        "headCommitSha"
      ],
      "properties": {
        "mode": {
          "enum": ["direct", "merge-base"]
        },
        "baseRef": {
          "$ref": "#/definitions/portableReference"
        },
        "headRef": {
          "$ref": "#/definitions/portableReference"
        },
        "baseCommitSha": {
          "$ref": "#/definitions/identifier"
        },
        "headCommitSha": {
          "$ref": "#/definitions/identifier"
        },
        "mergeBaseSha": {
          "$ref": "#/definitions/identifier"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": { "const": "merge-base" }
            }
          },
          "then": {
            "required": ["mergeBaseSha"]
          }
        },
        {
          "if": {
            "properties": {
              "mode": { "const": "direct" }
            }
          },
          "then": {
            "not": {
              "required": ["mergeBaseSha"]
            }
          }
        }
      ]
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "detector", "contentHash"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "kind": { "const": "source" },
        "path": { "$ref": "#/definitions/portablePath" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 },
        "location": { "$ref": "#/definitions/sourceLocation" },
        "revision": { "$ref": "#/definitions/identifier" },
        "reference": { "$ref": "#/definitions/portableReference" },
        "observedAt": { "$ref": "#/definitions/dateTime" },
        "observedCount": { "type": "integer", "minimum": 0 },
        "detector": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:@[A-Za-z0-9._-]+/)?[A-Za-z0-9._-]+@[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "contentHash": { "$ref": "#/definitions/contentHash" }
      },
      "allOf": [
        {
          "anyOf": [{ "required": ["path"] }, { "required": ["location"] }]
        },
        {
          "anyOf": [{ "required": ["line"] }, { "required": ["location"] }]
        }
      ]
    },
    "nonSourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "kind": { "enum": ["runtime", "git", "user"] },
        "path": { "$ref": "#/definitions/portablePath" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 },
        "location": { "$ref": "#/definitions/sourceLocation" },
        "revision": { "$ref": "#/definitions/identifier" },
        "reference": { "$ref": "#/definitions/portableReference" },
        "observedAt": { "$ref": "#/definitions/dateTime" },
        "observedCount": { "type": "integer", "minimum": 0 },
        "detector": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:@[A-Za-z0-9._-]+/)?[A-Za-z0-9._-]+@[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "contentHash": { "$ref": "#/definitions/contentHash" }
      }
    },
    "evidence": {
      "oneOf": [
        { "$ref": "#/definitions/sourceEvidence" },
        { "$ref": "#/definitions/nonSourceEvidence" }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stableKey", "kind", "name"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "stableKey": { "$ref": "#/definitions/identifier" },
        "kind": {
          "enum": [
            "endpoint",
            "module",
            "service",
            "function",
            "database_table",
            "queue",
            "external_service",
            "file",
            "unknown"
          ]
        },
        "name": { "$ref": "#/definitions/text" },
        "language": { "$ref": "#/definitions/identifier" },
        "location": { "$ref": "#/definitions/sourceLocation" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind", "confidence", "evidence"],
      "properties": {
        "from": { "$ref": "#/definitions/identifier" },
        "to": { "$ref": "#/definitions/identifier" },
        "kind": {
          "enum": [
            "calls",
            "imports",
            "reads",
            "writes",
            "publishes",
            "subscribes",
            "requests",
            "contains",
            "routes_to",
            "depends_on",
            "implements",
            "unknown"
          ]
        },
        "confidence": {
          "enum": ["certain", "inferred", "observed", "user_confirmed"]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidence" }
        },
        "unresolvedReason": { "$ref": "#/definitions/text" }
      },
      "anyOf": [
        {
          "properties": {
            "evidence": { "minItems": 1 }
          }
        },
        { "required": ["unresolvedReason"] }
      ]
    },
    "diagnosticEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "$ref": "#/definitions/identifier" },
        "to": { "$ref": "#/definitions/identifier" },
        "kind": { "$ref": "#/definitions/edge/properties/kind" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "severity", "message", "evidence"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "code": { "$ref": "#/definitions/identifier" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "$ref": "#/definitions/text" },
        "remediation": { "$ref": "#/definitions/text" },
        "nodeId": { "$ref": "#/definitions/identifier" },
        "edge": { "$ref": "#/definitions/diagnosticEdge" },
        "location": { "$ref": "#/definitions/sourceLocation" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidence" }
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodesAdded",
        "nodesRemoved",
        "nodesChanged",
        "edgesAdded",
        "edgesRemoved",
        "edgesChanged",
        "diagnosticsAdded",
        "diagnosticsRemoved",
        "diagnosticsChanged"
      ],
      "properties": {
        "nodesAdded": { "$ref": "#/definitions/count" },
        "nodesRemoved": { "$ref": "#/definitions/count" },
        "nodesChanged": { "$ref": "#/definitions/count" },
        "edgesAdded": { "$ref": "#/definitions/count" },
        "edgesRemoved": { "$ref": "#/definitions/count" },
        "edgesChanged": { "$ref": "#/definitions/count" },
        "diagnosticsAdded": { "$ref": "#/definitions/count" },
        "diagnosticsRemoved": { "$ref": "#/definitions/count" },
        "diagnosticsChanged": { "$ref": "#/definitions/count" }
      }
    },
    "topologyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind", "evidence"],
      "properties": {
        "from": { "$ref": "#/definitions/identifier" },
        "to": { "$ref": "#/definitions/identifier" },
        "kind": { "$ref": "#/definitions/edge/properties/kind" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidence" }
        }
      }
    },
    "topologyCycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodes", "edges"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/identifier" }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/topologyEdge" }
        }
      }
    },
    "topologyLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "nodeIds"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "order": { "type": "integer", "minimum": 0 },
        "nodeIds": {
          "type": "array",
          "items": { "$ref": "#/definitions/identifier" }
        }
      }
    },
    "topologyViolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromLayer", "toLayer", "edge"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "fromLayer": { "$ref": "#/definitions/identifier" },
        "toLayer": { "$ref": "#/definitions/identifier" },
        "edge": { "$ref": "#/definitions/topologyEdge" }
      }
    },
    "topologySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycles", "layers", "violations", "diagnostics"],
      "properties": {
        "cycles": {
          "type": "array",
          "items": { "$ref": "#/definitions/topologyCycle" }
        },
        "layers": {
          "type": "array",
          "items": { "$ref": "#/definitions/topologyLayer" }
        },
        "violations": {
          "type": "array",
          "items": { "$ref": "#/definitions/topologyViolation" }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/definitions/diagnostic" }
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "$ref": "#/definitions/topologySummary" },
        "after": { "$ref": "#/definitions/topologySummary" }
      }
    },
    "fieldChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "before", "after"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "before": {},
        "after": {}
      }
    },
    "edgeChangeClassification": {
      "enum": ["edge-changed", "evidence-only", "confidence-changed"]
    },
    "changedNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stableKey", "before", "after", "changes"],
      "properties": {
        "stableKey": {
          "$ref": "#/definitions/identifier"
        },
        "before": {
          "$ref": "#/definitions/node"
        },
        "after": {
          "$ref": "#/definitions/node"
        },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/definitions/fieldChange" }
        },
        "classification": {
          "const": "node-changed"
        }
      }
    },
    "identityMatchMethod": {
      "enum": ["stable-key", "same-name", "path-history", "neighborhood"]
    },
    "identityMatchConfidence": {
      "enum": ["exact", "strong"]
    },
    "identitySignal": {
      "enum": [
        "stable-key",
        "path-history",
        "same-kind",
        "same-language",
        "same-name",
        "same-neighborhood",
        "neighborhood-overlap"
      ]
    },
    "identityCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeStableKey", "afterStableKey", "score", "signals"],
      "properties": {
        "beforeStableKey": { "$ref": "#/definitions/identifier" },
        "afterStableKey": { "$ref": "#/definitions/identifier" },
        "score": { "type": "number" },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/identitySignal" }
        }
      }
    },
    "identityMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beforeStableKey",
        "afterStableKey",
        "score",
        "signals",
        "before",
        "after",
        "method",
        "confidence"
      ],
      "properties": {
        "beforeStableKey": { "$ref": "#/definitions/identifier" },
        "afterStableKey": { "$ref": "#/definitions/identifier" },
        "score": { "type": "number" },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/identitySignal" }
        },
        "before": { "$ref": "#/definitions/node" },
        "after": { "$ref": "#/definitions/node" },
        "method": { "$ref": "#/definitions/identityMatchMethod" },
        "confidence": {
          "$ref": "#/definitions/identityMatchConfidence"
        }
      }
    },
    "identityAmbiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "candidates", "reason"],
      "properties": {
        "before": { "$ref": "#/definitions/node" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/definitions/identityCandidate" }
        },
        "reason": { "enum": ["equal-score", "non-mutual-best"] }
      }
    },
    "identityUnsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "score", "signals", "reason"],
      "properties": {
        "before": { "$ref": "#/definitions/node" },
        "after": { "$ref": "#/definitions/node" },
        "score": { "type": "number" },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/identitySignal" }
        },
        "reason": { "const": "unsupported-rename" }
      }
    },
    "identityChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matches", "ambiguous"],
      "properties": {
        "matches": {
          "type": "array",
          "items": { "$ref": "#/definitions/identityMatch" }
        },
        "ambiguous": {
          "type": "array",
          "items": { "$ref": "#/definitions/identityAmbiguity" }
        },
        "unsupported": {
          "type": "array",
          "items": { "$ref": "#/definitions/identityUnsupported" }
        }
      }
    },
    "changedEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind", "before", "after", "changes"],
      "properties": {
        "from": {
          "$ref": "#/definitions/identifier"
        },
        "to": {
          "$ref": "#/definitions/identifier"
        },
        "kind": {
          "$ref": "#/definitions/edge/properties/kind"
        },
        "before": {
          "$ref": "#/definitions/edge"
        },
        "after": {
          "$ref": "#/definitions/edge"
        },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/definitions/fieldChange" }
        },
        "classification": {
          "$ref": "#/definitions/edgeChangeClassification"
        }
      }
    },
    "rewiredEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "changes", "classification"],
      "properties": {
        "before": {
          "$ref": "#/definitions/edge"
        },
        "after": {
          "$ref": "#/definitions/edge"
        },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/definitions/fieldChange" }
        },
        "classification": {
          "const": "endpoint-rewired"
        }
      }
    },
    "changedDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "before", "after", "changes"],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "before": {
          "$ref": "#/definitions/diagnostic"
        },
        "after": {
          "$ref": "#/definitions/diagnostic"
        },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/definitions/fieldChange" }
        },
        "classification": {
          "const": "diagnostic-changed"
        }
      }
    },
    "nodeChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "changed"],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        },
        "changed": {
          "type": "array",
          "items": { "$ref": "#/definitions/changedNode" }
        }
      }
    },
    "edgeChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "changed"],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/edge"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/edge"
          }
        },
        "changed": {
          "type": "array",
          "items": { "$ref": "#/definitions/changedEdge" }
        },
        "rewired": {
          "type": "array",
          "items": { "$ref": "#/definitions/rewiredEdge" }
        }
      }
    },
    "diagnosticChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "changed"],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/diagnostic"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/diagnostic"
          }
        },
        "changed": {
          "type": "array",
          "items": { "$ref": "#/definitions/changedDiagnostic" }
        }
      }
    }
  }
}
