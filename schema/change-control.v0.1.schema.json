{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/change-control.v0.1.schema.json",
  "title": "CARTOGRAPH change-control register v0.1",
  "description": "Owners, review dates, replacements, and removal gates for long-lived compatibility surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registerVersion", "asOf", "entries"],
  "properties": {
    "registerVersion": { "const": 1 },
    "asOf": { "$ref": "#/definitions/date" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\\\)(?!~)(?![A-Za-z]:[\\\\/])(?!.*\\.\\.)[^\\u0000]+$"
    },
    "removalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migrationNote", "fixtureUpdate", "validationCommand"],
      "properties": {
        "migrationNote": { "$ref": "#/definitions/portablePath" },
        "fixtureUpdate": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/portablePath" }
        },
        "validationCommand": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "status",
        "introducedVersion",
        "owner",
        "reviewDate",
        "replacement",
        "removalGate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "kind": {
          "enum": ["schema", "cli-flag", "adapter-capability", "policy-feature"]
        },
        "status": { "enum": ["active", "deprecated", "removed"] },
        "introducedVersion": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "reviewDate": { "$ref": "#/definitions/date" },
        "replacement": {
          "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "deprecationReason": { "type": ["string", "null"], "minLength": 1 },
        "deprecatedSince": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/date" }]
        },
        "removalGate": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/removalGate" }]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["deprecated", "removed"] } }
          },
          "then": {
            "required": ["deprecationReason", "deprecatedSince"],
            "properties": {
              "replacement": { "type": "string", "minLength": 1 },
              "removalGate": { "$ref": "#/definitions/removalGate" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "active" } } },
          "then": {
            "properties": {
              "deprecationReason": { "type": "null" },
              "deprecatedSince": { "type": "null" },
              "replacement": { "type": "null" },
              "removalGate": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
