{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/fixture-provenance.v0.1.schema.json",
  "title": "CARTOGRAPH fixture provenance manifest v0.1",
  "description": "License, source, reproducibility, transformation, and redistribution metadata for checked-in fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/fixture" }
    }
  },
  "definitions": {
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!~)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "$ref": "#/definitions/portablePath" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "source",
        "license",
        "reference",
        "transformation",
        "redistribution"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "path": { "$ref": "#/definitions/portablePath" },
        "source": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "transformation": { "type": "string", "minLength": 1 },
        "redistribution": {
          "enum": ["allowed", "restricted", "not-redistributable"]
        },
        "generated": {
          "type": "array",
          "items": { "$ref": "#/definitions/generated" }
        }
      }
    }
  }
}
