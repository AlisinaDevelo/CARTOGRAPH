{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/workspace-composition.v0.1.schema.json",
  "title": "CARTOGRAPH offline workspace composition manifest v0.1",
  "description": "A bounded local manifest for composing independently produced architecture snapshots without embedding source or fetching repositories.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "workspaceId",
    "workspaceVersion",
    "repositories",
    "limits"
  ],
  "properties": {
    "$schema": { "type": "string", "maxLength": 512 },
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.workspace-composition" },
    "workspaceId": { "$ref": "#/definitions/identifier" },
    "workspaceVersion": { "$ref": "#/definitions/semver" },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/definitions/repository" }
    },
    "omissions": {
      "type": "array",
      "maxItems": 64,
      "default": [],
      "items": { "$ref": "#/definitions/omission" }
    },
    "boundaries": {
      "type": "array",
      "maxItems": 256,
      "default": [],
      "items": { "$ref": "#/definitions/boundary" }
    },
    "limits": { "$ref": "#/definitions/limits" }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "adapterVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "revision": {
      "type": "string",
      "minLength": 7,
      "maxLength": 128,
      "pattern": "^(?:[0-9a-f]{7,128}|working-tree)$"
    },
    "localPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!~)(?!//)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*\\u0000).+$"
    },
    "localFile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!\\.?$)(?!/)(?!~)(?!//)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*\\u0000).+$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schemaVersion",
        "adapterId",
        "adapterVersion",
        "sizeBytes"
      ],
      "properties": {
        "path": { "$ref": "#/definitions/localFile" },
        "schemaVersion": { "const": 1 },
        "adapterId": { "$ref": "#/definitions/identifier" },
        "adapterVersion": { "$ref": "#/definitions/adapterVersion" },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "logicalName", "revision", "localPath", "snapshot"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "logicalName": { "$ref": "#/definitions/displayName" },
        "revision": { "$ref": "#/definitions/revision" },
        "localPath": { "$ref": "#/definitions/localPath" },
        "snapshot": { "$ref": "#/definitions/snapshot" }
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "logicalName", "reason"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "logicalName": { "$ref": "#/definitions/displayName" },
        "reason": { "$ref": "#/definitions/text" },
        "requestedPath": { "$ref": "#/definitions/localPath" }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromRepository", "toRepository", "relation"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "fromRepository": { "$ref": "#/definitions/identifier" },
        "toRepository": { "$ref": "#/definitions/identifier" },
        "relation": {
          "enum": ["depends-on", "references", "contains", "unknown"]
        },
        "status": { "enum": ["declared", "unresolved"], "default": "declared" },
        "evidencePath": { "$ref": "#/definitions/localFile" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRepositories",
        "maxOmissions",
        "maxBoundaries",
        "maxSnapshotBytes",
        "maxTotalSnapshotBytes"
      ],
      "properties": {
        "maxRepositories": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxOmissions": { "type": "integer", "minimum": 0, "maximum": 64 },
        "maxBoundaries": { "type": "integer", "minimum": 0, "maximum": 256 },
        "maxSnapshotBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "maxTotalSnapshotBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      }
    }
  }
}
