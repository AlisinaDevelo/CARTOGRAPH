{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/assurance-signing-keyring.v0.1.schema.json",
  "title": "CARTOGRAPH assurance signing keyring v0.1",
  "description": "An offline set of public assurance signing keys; private keys are never accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "keys"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/definitions/key" }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "dateTime": { "type": "string", "format": "date-time" },
    "base64url": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "trustRootId",
        "algorithm",
        "algorithmVersion",
        "publicKey",
        "status",
        "validFrom",
        "validUntil",
        "retiredAt",
        "revokedAt",
        "rotatedFrom"
      ],
      "properties": {
        "keyId": { "$ref": "#/definitions/identifier" },
        "trustRootId": { "$ref": "#/definitions/identifier" },
        "algorithm": { "type": "string", "minLength": 1, "maxLength": 64 },
        "algorithmVersion": { "type": "integer", "minimum": 1 },
        "publicKey": { "$ref": "#/definitions/base64url" },
        "status": { "enum": ["active", "retired", "revoked"] },
        "validFrom": { "$ref": "#/definitions/dateTime" },
        "validUntil": { "$ref": "#/definitions/dateTime" },
        "retiredAt": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/dateTime" }]
        },
        "revokedAt": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/dateTime" }]
        },
        "rotatedFrom": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/identifier" }]
        }
      }
    }
  }
}
