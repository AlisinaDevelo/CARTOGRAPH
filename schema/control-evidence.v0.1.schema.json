{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/control-evidence.v0.1.schema.json",
  "title": "CARTOGRAPH control evidence report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "limitations",
    "asOf",
    "bundleId",
    "controls",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "cartograph.control-evidence"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "owner",
          "scope",
          "period",
          "applicability",
          "status",
          "observed",
          "asserted",
          "gaps",
          "conflicts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description"],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "paths": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            }
          },
          "period": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {
                "type": "string",
                "format": "date-time"
              },
              "to": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "applicability": {
            "enum": ["full", "partial", "not-applicable"]
          },
          "applicabilityNote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "status": {
            "enum": [
              "supported",
              "asserted-only",
              "gaps",
              "conflicting",
              "out-of-period",
              "not-applicable"
            ]
          },
          "observed": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/item"
            }
          },
          "asserted": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/item"
            }
          },
          "gaps": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/item"
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/item"
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "asserted-only",
        "gaps",
        "conflicting",
        "out-of-period",
        "not-applicable"
      ],
      "properties": {
        "supported": {
          "type": "integer",
          "minimum": 0
        },
        "asserted-only": {
          "type": "integer",
          "minimum": 0
        },
        "gaps": {
          "type": "integer",
          "minimum": 0
        },
        "conflicting": {
          "type": "integer",
          "minimum": 0
        },
        "out-of-period": {
          "type": "integer",
          "minimum": 0
        },
        "not-applicable": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "definitions": {
    "item": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "type", "ref", "basis"],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "type": {
              "enum": [
                "policy-rule",
                "decision",
                "waiver",
                "finding",
                "bundle-artifact",
                "test",
                "owner-assertion"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "const": "observed"
            },
            "detail": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "type", "ref", "basis", "by", "at"],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "type": {
              "enum": [
                "policy-rule",
                "decision",
                "waiver",
                "finding",
                "bundle-artifact",
                "test",
                "owner-assertion"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "const": "asserted"
            },
            "by": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "type", "ref", "basis", "reason"],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "type": {
              "enum": [
                "policy-rule",
                "decision",
                "waiver",
                "finding",
                "bundle-artifact",
                "test",
                "owner-assertion"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "const": "gap"
            },
            "reason": {
              "enum": [
                "missing",
                "declared-missing",
                "not-evaluated",
                "unsupported-rule",
                "decision-not-accepted",
                "stale"
              ]
            },
            "detail": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "type", "ref", "basis", "reason"],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "type": {
              "enum": [
                "policy-rule",
                "decision",
                "waiver",
                "finding",
                "bundle-artifact",
                "test",
                "owner-assertion"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "const": "conflict"
            },
            "reason": {
              "enum": [
                "rule-violated",
                "decision-rejected",
                "finding-state",
                "test-failed"
              ]
            },
            "detail": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
