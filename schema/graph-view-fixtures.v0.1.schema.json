{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/graph-view-fixtures.v0.1.schema.json",
  "title": "CARTOGRAPH graph-view validation fixtures v0.1",
  "description": "Bounded local scenarios for replaying graph-view determinism, omissions, legends, and static rendering.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.graph-view-fixtures" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/scenario" }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "snapshotFile", "query", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "snapshotFile": { "type": "string", "pattern": "^[a-zA-Z0-9._/-]+$" },
        "query": { "type": "object" },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodes",
            "edges",
            "omittedNodes",
            "omittedEdges",
            "omittedDiagnostics",
            "unresolvedEdges"
          ],
          "properties": {
            "nodes": { "type": "integer", "minimum": 0 },
            "edges": { "type": "integer", "minimum": 0 },
            "omittedNodes": { "type": "integer", "minimum": 0 },
            "omittedEdges": { "type": "integer", "minimum": 0 },
            "omittedDiagnostics": { "type": "integer", "minimum": 0 },
            "unresolvedEdges": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
