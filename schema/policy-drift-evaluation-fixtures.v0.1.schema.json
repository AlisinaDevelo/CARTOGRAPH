{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/policy-drift-evaluation-fixtures.v0.1.schema.json",
  "title": "CARTOGRAPH policy and decision drift evaluation fixtures v0.1",
  "description": "A curated offline scenario contract for policy and ADR drift evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contract",
    "evaluationId",
    "evaluatedAt",
    "decisionTarget",
    "thresholds",
    "cases"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.policy-drift-evaluation-fixtures" },
    "evaluationId": { "$ref": "#/definitions/identifier" },
    "evaluatedAt": { "$ref": "#/definitions/dateTime" },
    "decisionTarget": { "enum": ["proceed", "hold"] },
    "thresholds": { "$ref": "#/definitions/thresholds" },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/definitions/case" }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "dateTime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "findingCategory": {
      "enum": [
        "decision-supersession",
        "removed-architecture",
        "policy-change",
        "unreferenced-addition",
        "exception-handling",
        "schema-compatibility"
      ]
    },
    "severity": { "enum": ["info", "warning", "error"] },
    "expectedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "severity"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "category": { "$ref": "#/definitions/findingCategory" },
        "severity": { "$ref": "#/definitions/severity" }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minutes", "steps", "disposition"],
      "properties": {
        "minutes": { "type": "integer", "minimum": 1, "maximum": 240 },
        "steps": { "type": "integer", "minimum": 1, "maximum": 100 },
        "disposition": {
          "enum": ["accepted", "overridden", "rejected", "unreviewed"]
        },
        "falsePositiveCategory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "expectedFindings", "reviewer"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "kind": {
          "enum": [
            "decision-supersession",
            "removed-architecture",
            "policy-change",
            "unreferenced-addition",
            "exception",
            "mixed-schema"
          ]
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "expectedFindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/definitions/expectedFinding" }
        },
        "reviewer": { "$ref": "#/definitions/reviewer" }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minFindingRecall",
        "maxUnexpectedFindingRate",
        "maxReviewerFalsePositiveRate",
        "maxReviewerMinutes",
        "minEvidenceReviewRate"
      ],
      "properties": {
        "minFindingRecall": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxUnexpectedFindingRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxReviewerFalsePositiveRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxReviewerMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "minEvidenceReviewRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
