{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/workspace-identity.v0.1.schema.json",
  "title": "CARTOGRAPH cross-repository workspace identity composition v0.1",
  "description": "Deterministic, read-only namespaces for composing independently produced graph snapshots without rewriting local identities or silently merging ambiguous origins.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "namespaces",
    "identities",
    "ambiguities",
    "snapshots"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.workspace-identity" },
    "namespaces": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/definitions/namespace" }
    },
    "identities": {
      "type": "array",
      "maxItems": 200000,
      "items": { "$ref": "#/definitions/composedIdentity" }
    },
    "ambiguities": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/definitions/ambiguity" }
    },
    "snapshots": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/definitions/snapshot" }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "originKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000\\r\\n\\s]+$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!~)(?!//)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*\\u0000).+$"
    },
    "resolution": {
      "enum": ["unique", "ambiguous", "origin-unavailable"]
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryId",
        "logicalName",
        "namespace",
        "resolution",
        "originAliases",
        "repositoryAliases"
      ],
      "properties": {
        "repositoryId": { "$ref": "#/definitions/identifier" },
        "logicalName": { "$ref": "#/definitions/displayName" },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "resolution": { "$ref": "#/definitions/resolution" },
        "canonicalOrigin": { "$ref": "#/definitions/originKey" },
        "forkOf": { "$ref": "#/definitions/originKey" },
        "originAliases": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/definitions/originKey" }
        },
        "repositoryAliases": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/definitions/identifier" }
        },
        "localPath": { "$ref": "#/definitions/portablePath" }
      }
    },
    "ambiguityKind": {
      "enum": [
        "duplicate-origin",
        "alias-collision",
        "logical-name-collision",
        "origin-unavailable"
      ]
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key", "repositoryIds", "detail"],
      "properties": {
        "kind": { "$ref": "#/definitions/ambiguityKind" },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "repositoryIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/definitions/identifier" }
        },
        "detail": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "composedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryId",
        "namespace",
        "resolution",
        "localStableKey",
        "composedStableKey",
        "nodeId",
        "node"
      ],
      "properties": {
        "repositoryId": { "$ref": "#/definitions/identifier" },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "resolution": { "$ref": "#/definitions/resolution" },
        "localStableKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "composedStableKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "node": {
          "$ref": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/graph-snapshot.v0.1.schema.json#/definitions/node"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "snapshot"],
      "properties": {
        "repositoryId": { "$ref": "#/definitions/identifier" },
        "snapshot": {
          "$ref": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/graph-snapshot.v0.1.schema.json"
        }
      }
    }
  }
}
