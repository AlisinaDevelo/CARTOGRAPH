{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/control-mapping.v0.1.schema.json",
  "title": "CARTOGRAPH control mapping v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "controls"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "cartograph.control-mapping"
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "objective",
          "owner",
          "scope",
          "period",
          "applicability",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description"],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "paths": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            }
          },
          "period": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {
                "type": "string",
                "format": "date-time"
              },
              "to": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "applicability": {
            "enum": ["full", "partial", "not-applicable"]
          },
          "applicabilityNote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "policyId", "ruleId"],
                  "properties": {
                    "type": {
                      "const": "policy-rule"
                    },
                    "policyId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "ruleId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "decisionId"],
                  "properties": {
                    "type": {
                      "const": "decision"
                    },
                    "decisionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "waiverId"],
                  "properties": {
                    "type": {
                      "const": "waiver"
                    },
                    "waiverId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "findingId"],
                  "properties": {
                    "type": {
                      "const": "finding"
                    },
                    "findingId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "expectedStates": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "role"],
                  "properties": {
                    "type": {
                      "const": "bundle-artifact"
                    },
                    "role": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "name", "result", "ranAt", "reportedBy"],
                  "properties": {
                    "type": {
                      "const": "test"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "result": {
                      "enum": ["pass", "fail"]
                    },
                    "ranAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "reportedBy": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "owner", "statement", "assertedAt"],
                  "properties": {
                    "type": {
                      "const": "owner-assertion"
                    },
                    "owner": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "assertedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              ]
            }
          }
        },
        "if": {
          "properties": {
            "applicability": {
              "enum": ["partial", "not-applicable"]
            }
          }
        },
        "then": {
          "required": ["applicabilityNote"]
        }
      }
    }
  }
}
