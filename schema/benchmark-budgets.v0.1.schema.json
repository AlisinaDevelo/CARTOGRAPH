{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/benchmark-budgets.v0.1.schema.json",
  "title": "CARTOGRAPH benchmark budgets v0.1",
  "description": "Small, medium, and large bounded fixture budgets for release performance evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contract",
    "budgetId",
    "baseline",
    "regression",
    "tiers"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.benchmark-budgets" },
    "budgetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "protocolVersion", "metricModes"],
      "properties": {
        "artifact": { "const": "benchmarks/baseline.v0.1.json" },
        "protocolVersion": { "const": 1 },
        "metricModes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["cold", "warm"] }
        }
      }
    },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxPercent", "explanationRequired"],
      "properties": {
        "maxPercent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "explanationRequired": { "const": true }
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fixtureIds",
          "maxP95Ms",
          "maxPeakRssBytes",
          "maxReportBytes"
        ],
        "properties": {
          "id": { "enum": ["small", "medium", "large"] },
          "fixtureIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "maxP95Ms": { "type": "number", "exclusiveMinimum": 0 },
          "maxPeakRssBytes": { "type": "integer", "exclusiveMinimum": 0 },
          "maxReportBytes": { "type": "integer", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
