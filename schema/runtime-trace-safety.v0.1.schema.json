{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/runtime-trace-safety.v0.1.schema.json",
  "title": "CARTOGRAPH runtime trace safety policy v0.1",
  "description": "A local, explicit field-redaction and bounded in-memory retention policy for normalized runtime traces. No disk retention, collector, upload, or implicit reconciliation is enabled.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "mediaType",
    "redaction",
    "retention"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.runtime-trace-safety" },
    "mediaType": {
      "const": "application/vnd.cartograph.runtime-trace-safety+json"
    },
    "redaction": { "$ref": "#/definitions/redaction" },
    "retention": { "$ref": "#/definitions/retention" }
  },
  "definitions": {
    "redactionField": {
      "enum": [
        "span.name",
        "span.serviceName",
        "span.scopeName",
        "span.scopeVersion"
      ]
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "replacement"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/redactionField" }
        },
        "replacement": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxTraces", "maxBytes", "ttlMs"],
      "properties": {
        "mode": { "enum": ["memory-only", "discard-after-read"] },
        "maxTraces": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "ttlMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2592000000
        }
      }
    }
  }
}
