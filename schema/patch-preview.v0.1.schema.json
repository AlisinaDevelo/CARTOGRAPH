{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlisinaDevelo/CARTOGRAPH/schema/patch-preview.v0.1.schema.json",
  "title": "CARTOGRAPH isolated patch preview request v0.1",
  "description": "Digest-guarded text operations for an isolated, read-only-by-default patch preview.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "previewId",
    "sourceRef",
    "operations",
    "validationCommands"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "cartograph.patch-preview" },
    "previewId": { "$ref": "#/definitions/identifier" },
    "sourceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "anyOf": [{ "pattern": "^-" }, { "pattern": "[\\u0000\\r\\n]" }]
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/definitions/operation" }
    },
    "validationCommands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["verify-patch", "node-version", "npm-version"] }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![\\\\/])(?!~)(?![A-Za-z][A-Za-z\\d+.-]*:)(?!.*[\\u0000])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!^\\.?$).+"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expectedDigest", "replacement"],
      "properties": {
        "path": { "$ref": "#/definitions/path" },
        "expectedDigest": { "$ref": "#/definitions/digest" },
        "replacement": { "type": "string", "maxLength": 65536 }
      }
    }
  }
}
