{
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["../core/src/*"]
    },
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "target": "ES2023"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/generated/**"],
  "references": [{ "path": "../core" }]
}
