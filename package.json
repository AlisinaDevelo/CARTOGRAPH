{
  "name": "cartograph-cli",
  "version": "0.1.0",
  "description": "Deterministic architecture graph scanning and evidence-backed revision diffs for TypeScript.",
  "type": "module",
  "bin": {
    "cartograph": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "release:validate": "node scripts/release-artifact.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run schema:compatibility && npm run support:validate && npm run upgrade:validate && npm run release-compatibility:validate && npm run migrations:validate && npm run fixtures:validate && npm run identity:validate && npm run identity:portability:validate && npm run identity:quality:validate && npm run compatibility:validate && npm run benchmark:validate && npm run benchmark:budgets:validate && npm run property:validate && npm run benchmark:ci && npm run policy:validate && npm run policy-bundle:validate && npm run policy-bundle:migrations:validate && npm run assurance-signing:validate && npm run remediation-suggestions:validate && npm run remediation-separation:validate && npm run remediation-rules:validate && npm run patch-preview:validate && npm run model-provider-privacy:validate && npm run remediation-review:validate && npm run remediation-evaluation:validate && npm run change-control:validate && npm run adr:validate && npm run adr-lifecycle:validate && npm run policy-evaluation:validate && npm run policy-regression:validate && npm run policy-composition:validate && npm run policy-exceptions:validate && npm run policy-drift:validate && npm run policy-adr-bindings:validate && npm run adapter:validate && npm run adapter:compatibility:validate && npm run adapter:support:validate && npm run adapter-starter:validate && npm run runtime-traces:validate && npm run runtime-reconciliation:validate && npm run runtime-reconciliation:evaluation:validate && npm run runtime-trace-safety:validate && npm run runtime-trace-budgets:validate && npm run test:coverage && npm run roadmap:validate && npm run roadmap:test && npm run build && npm run release:validate && npm run quickstart:validate && npm run workflow:validate && npm run action:validate && npm run action:security:validate && npm run docs:links:validate",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "roadmap:test": "node --test roadmap/github-roadmap.test.mjs",
    "roadmap:validate": "node scripts/github-roadmap.mjs validate",
    "fixtures:validate": "node scripts/fixture-provenance.mjs validate",
    "identity:validate": "node --import tsx scripts/identity-corpus.ts",
    "identity:portability:validate": "node --import tsx scripts/identity-portability.ts",
    "identity:quality:validate": "node --import tsx scripts/identity-quality.ts",
    "support:validate": "node --import tsx scripts/support-matrix.mjs validate",
    "upgrade:validate": "node scripts/upgrade-policy.mjs validate",
    "release-compatibility:validate": "node scripts/release-compatibility.mjs validate",
    "compatibility:validate": "node scripts/compatibility-review.mjs",
    "benchmark:run": "node --import tsx scripts/benchmark.mjs run",
    "benchmark:validate": "node scripts/benchmark.mjs validate",
    "benchmark:budgets:validate": "node scripts/benchmark-budgets.mjs validate",
    "property:validate": "node --import tsx scripts/property-regressions.mjs validate",
    "benchmark:ci": "node scripts/benchmark-gate.mjs",
    "adr:validate": "node --import tsx scripts/adr.mjs validate",
    "adr-lifecycle:validate": "node --import tsx scripts/adr-lifecycle.mjs validate",
    "policy-evaluation:validate": "node --import tsx scripts/policy-evaluation.mjs validate",
    "policy-regression:validate": "node --import tsx scripts/policy-regression.mjs validate",
    "policy-composition:validate": "node --import tsx scripts/policy-composition.mjs validate",
    "policy-exceptions:validate": "node --import tsx scripts/policy-exceptions.mjs validate",
    "policy-drift:validate": "node --import tsx scripts/policy-drift-evaluation.mjs validate",
    "policy-adr-bindings:validate": "node --import tsx scripts/policy-adr-bindings.mjs validate",
    "adapter:validate": "node --import tsx scripts/adapter.mjs validate",
    "adapter:compatibility:validate": "node --import tsx scripts/adapter-compatibility-matrix.mjs validate",
    "adapter:support:validate": "node --import tsx scripts/adapter-support.mjs validate",
    "adapter-starter:validate": "node --import tsx scripts/adapter-starter.mjs validate",
    "action:validate": "node scripts/action-fixture.mjs",
    "action:security:validate": "node scripts/action-security-fixture.mjs",
    "quickstart:validate": "node scripts/quickstart-fixture.mjs",
    "workflow:validate": "node scripts/workflow-fixture.mjs",
    "docs:links:validate": "node scripts/docs-links.mjs",
    "runtime-traces:validate": "node --import tsx scripts/runtime-traces.mjs validate",
    "runtime-reconciliation:validate": "node --import tsx scripts/runtime-reconciliation.mjs validate",
    "runtime-reconciliation:evaluation:validate": "node --import tsx scripts/runtime-reconciliation-evaluation.mjs validate",
    "runtime-trace-safety:validate": "node --import tsx scripts/runtime-trace-safety.mjs validate",
    "runtime-trace-budgets:validate": "node --import tsx scripts/runtime-trace-budgets.mjs validate",
    "policy-bundle:validate": "node --import tsx scripts/policy-bundle.mjs validate",
    "policy:validate": "node --import tsx scripts/policy.mjs validate",
    "policy-bundle:migrations:validate": "node --import tsx scripts/policy-bundle-migrations.mjs validate",
    "assurance-signing:validate": "node --import tsx scripts/assurance-signing.mjs validate",
    "remediation-suggestions:validate": "node --import tsx scripts/remediation-suggestions.mjs validate",
    "remediation-separation:validate": "node --import tsx scripts/remediation-separation.mjs validate",
    "remediation-rules:validate": "node --import tsx scripts/remediation-rules.mjs validate",
    "patch-preview:validate": "node --import tsx scripts/patch-previews.mjs validate",
    "model-provider-privacy:validate": "node scripts/model-provider-privacy.mjs validate",
    "remediation-review:validate": "node --import tsx scripts/remediation-review.mjs validate",
    "remediation-evaluation:validate": "node --import tsx scripts/remediation-evaluation.mjs validate",
    "change-control:validate": "node scripts/change-control.mjs validate",
    "migrations:validate": "node scripts/migrations.mjs validate",
    "schema:compatibility": "node scripts/schema-compatibility.mjs check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "architecture",
    "architecture-diff",
    "code-analysis",
    "static-analysis",
    "typescript"
  ],
  "author": "Alisina Karimi",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlisinaDevelo/CARTOGRAPH.git"
  },
  "bugs": {
    "url": "https://github.com/AlisinaDevelo/CARTOGRAPH/issues"
  },
  "homepage": "https://github.com/AlisinaDevelo/CARTOGRAPH#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^6.15.0",
    "eslint": "^10.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
